{
  "name": "create-luolapeikko-backend",
  "version": "0.0.7",
  "type": "module",
  "description": "An easy way to start Javascript backend project",
  "main": "index.js",
  "scripts": {
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run  --reporter=verbose",
    "dev": "node --loader ts-node/esm ./src/index.ts",
    "dev:express-starter": "pnpm --filter express-starter run dev",
    "dev:express-websocket-starter": "pnpm --filter express-starter run dev",
    "dev:hono-starter": "pnpm --filter hono-starter run dev",
    "dev:fastify-starter": "pnpm --filter fastify-starter run dev",
    "build:express-starter": "pnpm --filter express-starter run build",
    "build:express-websocket-starter": "pnpm --filter express-websocket-starter run build",
    "start:express-starter": "pnpm --filter express-starter start",
    "build:templates": "pnpm -r build",
    "start": "node ./index.js",
    "lint": "eslint . --ext .ts"
  },
  "files": [
    "index.js",
    "template-*",
    "dist"
  ],
  "bin": {
    "create-luolapeikko-backend": "index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "template-express/",
    "template-express-websocket/",
    "template-hono/",
    "template-fastify/",
    "template-encore/"
  ],
  "repository": "github:luolapeikko/create-luolapeikko-backend",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.13.0",
    "@stylistic/eslint-plugin-ts": "^2.13.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/cross-spawn": "6.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.8",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-sonarjs": "^0.23.0",
    "express-starter": "file:template-express",
    "express-websocket-starter": "file:template-express-websocket",
    "fastify-starter": "file:template-fastify",
    "hono-starter": "file:template-hono",
    "minimist": "^1.2.8",
    "picocolors": "1.1.0",
    "prettier": "^3.4.2",
    "prompts": "^2.4.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "unbuild": "2.0.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.3"
  }
}